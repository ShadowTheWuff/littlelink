# Applied when building with the repo root as the context:
#   docker build -f docker/Dockerfile .
# Keeps repo metadata and deploy config out of the served image.

# Git & repo metadata
.git
.github
.gitignore
.pre-commit-config.yaml

# Deploy configs (not part of the site)
docker
.do
wrangler.toml

# Vercel Routing Middleware: runs on Vercel, must not be served as a file here.
middleware.js
.assetsignore
.dockerignore

# Documentation
README.md
LICENSE.md
VERSION.md
ai.md
.vercelignore

# Logs
*.log

# Editor, OS, and tooling files
.idea
.vscode
.devcontainer
.claude
.wrangler
node_modules
**/.DS_Store
