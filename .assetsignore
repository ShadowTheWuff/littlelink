# Cloudflare Workers static assets ignore list.
# Unlike Pages, Workers uploads everything in the assets directory by default,
# so this keeps repo metadata and deploy config out of the deployed site.
.git
.github
.gitignore
.pre-commit-config.yaml
docker
.do
wrangler.toml

# Vercel Routing Middleware: runs on Vercel, must not be served as a file here.
middleware.js
.dockerignore
.assetsignore
README.md
LICENSE.md
VERSION.md
ai.md
.vercelignore
.idea
.vscode
.devcontainer
.claude
.wrangler
node_modules
**/.DS_Store
